# F14.9 - Modello per lo smoke test sul PROGETTO SUPABASE DI PROVA (F14.8).
# Copiare in test/.smoke-progetto.env (escluso da git) e scrivere i valori
# del progetto di PROVA (mai quelli della produzione: lo script si ferma da
# solo se trova l'indirizzo o la chiave della produzione).
SMOKE_BACKEND=progetto
SMOKE_SUPABASE_URL=https://<ref-del-progetto-di-prova>.supabase.co
SMOKE_SUPABASE_ANON_KEY=<chiave anon pubblica del progetto di prova>
# Facoltativo: dove sono email e password degli utenti di prova
# (predefinito test/utenti-prova.json, escluso da git). Formato:
# { "titolare": { "email": "...", "password": "..." },
#   "informatico": {...}, "capo_tecnico": {...}, "segreteria": {...},
#   "contabile": {...}, "tecnico": {...}, "commerciale": {...},
#   "rappresentante": {...}, "ingegnere": {...} }
# SMOKE_UTENTI=/percorso/utenti-prova.json
